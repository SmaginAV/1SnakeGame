&НаКлиенте
Перем Игра;
&НаКлиенте
Перем СостояниеЭкрана;
&НаКлиенте
Перем ОжиданиеПодключено;
&НаКлиенте
Перем Палитра;
&НаКлиенте
Перем РезультатСохранен;
&НаКлиенте
Перем РезультатВТопе;
&НаКлиенте
Перем ОшибкаСохранения;
&НаКлиенте
Перем ИзображенияИгры;
&НаКлиенте
Перем ДокументИгровогоПоля;
&НаКлиенте
Перем ГеометрияКлеток;
&НаКлиенте
Перем ПоказанныеКлетки;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Палитра = ЦветаИгры();
	ОжиданиеПодключено = Ложь;
	ПоказатьМеню();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	ОстановитьОжидание();
	СостояниеЭкрана = "Закрыто";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеИгрыОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)

	СтандартнаяОбработка = Ложь;

	Если Расшифровка = "Начать" И СостояниеЭкрана = "Меню" Тогда

		НачатьПартию();

	ИначеЕсли Расшифровка = "Статистика" И СостояниеЭкрана = "Меню" Тогда

		ПоказатьСтатистику();

	ИначеЕсли Расшифровка = "Меню" Тогда

		ПоказатьМеню();

	ИначеЕсли Расшифровка = "ПовторитьСохранение" И СостояниеЭкрана = "Результат" Тогда

		СохранитьРезультат();
		ПоказатьРезультат();

	Иначе

		Возврат;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИмяТаблицы
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПовернутьВверх(Команда)

	ОбработатьНаправление("Вверх");

КонецПроцедуры

&НаКлиенте
Процедура ПовернутьВниз(Команда)

	ОбработатьНаправление("Вниз");

КонецПроцедуры

&НаКлиенте
Процедура ПовернутьВлево(Команда)

	ОбработатьНаправление("Влево");

КонецПроцедуры

&НаКлиенте
Процедура ПовернутьВправо(Команда)

	ОбработатьНаправление("Вправо");

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьПаузу(Команда)

	Если СостояниеЭкрана = "Игра" Тогда

		ОстановитьОжидание();
		СостояниеЭкрана = "Пауза";

	ИначеЕсли СостояниеЭкрана = "Пауза" Тогда

		СостояниеЭкрана = "Игра";
		ПодключитьСледующийШаг();

	Иначе

		Возврат;

	КонецЕсли;
	НарисоватьПодсказкуИгры();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяВМеню(Команда)

	Если СостояниеЭкрана <> "Меню" Тогда

		ПоказатьМеню();

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПравилаИгры()

	Возврат Новый Структура("Колонок,Рядов,НачальнаяДлина,ОчковЗаЕду,ИнтервалШага", 24, 20, 3, 10, 0.2);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция Клетка(Колонка, Ряд)

	Возврат Новый Структура("Колонка,Ряд", Колонка, Ряд);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СовпадаютКлетки(Первая, Вторая)

	Возврат Первая.Колонка = Вторая.Колонка И Первая.Ряд = Вторая.Ряд;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НоваяМодельИгры()

	Правила = ПравилаИгры();
	Змейка = Новый Массив;
	КолонкаГоловы = Цел(Правила.Колонок / 2);
	РядГоловы = Цел(Правила.Рядов / 2);

	Для Смещение = 0 По Правила.НачальнаяДлина - 1 Цикл

		Змейка.Добавить(Клетка(КолонкаГоловы - Смещение, РядГоловы));

	КонецЦикла;

	Модель = Новый Структура;
	Модель.Вставить("Правила", Правила);
	Модель.Вставить("Змейка", Змейка);
	Модель.Вставить("Направление", "Вправо");
	Модель.Вставить("Поворот", "");
	Модель.Вставить("Еда", Неопределено);
	Модель.Вставить("Очки", 0);
	Модель.Вставить("Исход", "");
	Модель.Вставить("ИдентификаторПартии", Строка(Новый УникальныйИдентификатор));
	Модель.Вставить("Генератор", Новый ГенераторСлучайныхЧисел);
	РазместитьЕду(Модель);
	Возврат Модель;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПринятьПоворот(Модель, Направление)

	Если Модель.Исход <> "" Или Модель.Поворот <> "" Или Направление = Модель.Направление Тогда

		Возврат Ложь;

	КонецЕсли;

	Противоположные = Новый Соответствие;
	Противоположные.Вставить("Вверх", "Вниз");
	Противоположные.Вставить("Вниз", "Вверх");
	Противоположные.Вставить("Влево", "Вправо");
	Противоположные.Вставить("Вправо", "Влево");

	Если Противоположные.Получить(Направление) = Неопределено
		Или Противоположные.Получить(Направление) = Модель.Направление Тогда

		Возврат Ложь;

	КонецЕсли;

	Модель.Поворот = Направление;
	Возврат Истина;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СледующаяКлетка(Голова, Направление)

	Следующая = Клетка(Голова.Колонка, Голова.Ряд);

	Если Направление = "Вверх" Тогда

		Следующая.Ряд = Следующая.Ряд - 1;

	ИначеЕсли Направление = "Вниз" Тогда

		Следующая.Ряд = Следующая.Ряд + 1;

	ИначеЕсли Направление = "Влево" Тогда

		Следующая.Колонка = Следующая.Колонка - 1;

	Иначе

		Следующая.Колонка = Следующая.Колонка + 1;

	КонецЕсли;

	Возврат Следующая;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ВыполнитьШагМодели(Модель)

	Если Модель.Исход <> "" Тогда

		Возврат;

	КонецЕсли;

	Если Модель.Поворот <> "" Тогда

		Модель.Направление = Модель.Поворот;
		Модель.Поворот = "";

	КонецЕсли;

	НоваяГолова = СледующаяКлетка(Модель.Змейка[0], Модель.Направление);
	Рост = СовпадаютКлетки(НоваяГолова, Модель.Еда);

	Если ЕстьСтолкновение(Модель, НоваяГолова, Рост) Тогда

		Модель.Исход = "Поражение";
		Возврат;

	КонецЕсли;

	Модель.Змейка.Вставить(0, НоваяГолова);

	Если Рост Тогда

		Модель.Очки = Модель.Очки + Модель.Правила.ОчковЗаЕду;
		РазместитьЕду(Модель);

	Иначе

		Модель.Змейка.Удалить(Модель.Змейка.Количество() - 1);

	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьСтолкновение(Модель, НоваяГолова, Рост)

	Если НоваяГолова.Колонка < 1 Или НоваяГолова.Колонка > Модель.Правила.Колонок
		Или НоваяГолова.Ряд < 1 Или НоваяГолова.Ряд > Модель.Правила.Рядов Тогда

		Возврат Истина;

	КонецЕсли;

	ПоследнийИндекс = Модель.Змейка.Количество() - 1;

	Если Не Рост Тогда

		// Хвост освобождает клетку в том же шаге, если змейка не растет.
		ПоследнийИндекс = ПоследнийИндекс - 1;

	КонецЕсли;

	Для Индекс = 0 По ПоследнийИндекс Цикл

		Если СовпадаютКлетки(НоваяГолова, Модель.Змейка[Индекс]) Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РазместитьЕду(Модель)

	Занятость = Новый Соответствие;

	Для Каждого Часть Из Модель.Змейка Цикл

		Номер = (Часть.Ряд - 1) * Модель.Правила.Колонок + Часть.Колонка;
		Занятость.Вставить(Номер, Истина);

	КонецЦикла;

	Свободные = Новый Массив;

	Для Ряд = 1 По Модель.Правила.Рядов Цикл

		Для Колонка = 1 По Модель.Правила.Колонок Цикл

			Номер = (Ряд - 1) * Модель.Правила.Колонок + Колонка;

			Если Занятость.Получить(Номер) = Неопределено Тогда

				Свободные.Добавить(Клетка(Колонка, Ряд));

			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Если Свободные.Количество() = 0 Тогда

		Модель.Еда = Неопределено;
		Модель.Исход = "Победа";
		Возврат;

	КонецЕсли;

	ВыбранныйИндекс = Модель.Генератор.СлучайноеЧисло(0, Свободные.Количество() - 1);
	Модель.Еда = Свободные[ВыбранныйИндекс];

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНаправление(Направление)

	Если СостояниеЭкрана = "Игра" Тогда

		ПринятьПоворот(Игра, Направление);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачатьПартию()

	ОстановитьОжидание();
	Игра = НоваяМодельИгры();
	СостояниеЭкрана = "Игра";
	РезультатСохранен = Ложь;
	РезультатВТопе = Ложь;
	ОшибкаСохранения = "";
	ПодготовитьЭкран(Истина);
	Надпись(1, 2, "1SnakeGame", Истина);
	ОбластьЭкрана(6, 2, 27, 27).ЦветФона = Палитра.Граница;
	ОбластьЭкрана(7, 3, 26, 26).ЦветФона = Палитра.Фон;
	НарисоватьПодсказкуИгры();
	НарисоватьСчет();

	Для Каждого Часть Из Игра.Змейка Цикл

		НарисоватьКлетку(Часть);

	КонецЦикла;

	НарисоватьКлетку(Игра.Еда);
	// Неактивное поле не поглощает стрелки и не рисует цветную рамку выбора.
	Элементы.ПолеИгры.Доступность = Ложь;
	ПодключитьСледующийШаг();

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьСледующийШаг()

	Если СостояниеЭкрана = "Игра" И Не ОжиданиеПодключено Тогда

		ПодключитьОбработчикОжидания("ШагИгры", Игра.Правила.ИнтервалШага, Истина);
		ОжиданиеПодключено = Истина;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ШагИгры()

	ОжиданиеПодключено = Ложь;

	Если СостояниеЭкрана <> "Игра" Тогда

		Возврат;

	КонецЕсли;

	ПрежнийХвост = Игра.Змейка[Игра.Змейка.Количество() - 1];
	ПрежняяДлина = Игра.Змейка.Количество();
	ВыполнитьШагМодели(Игра);

	Если Игра.Исход <> "" Тогда

		СостояниеЭкрана = "Результат";
		СохранитьРезультат();
		ПоказатьРезультат();
		Возврат;

	КонецЕсли;

	ОбновитьКлеткиШага(ПрежнийХвост);
	Если Игра.Змейка.Количество() <> ПрежняяДлина Тогда

		НарисоватьКлетку(Игра.Еда, -1);
		НарисоватьСчет();

	КонецЕсли;
	ПодключитьСледующийШаг();

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьОжидание()

	Если ОжиданиеПодключено Тогда

		ОтключитьОбработчикОжидания("ШагИгры");
		ОжиданиеПодключено = Ложь;

	КонецЕсли;

КонецПроцедуры

// BSLLS:StyleElementConstructors-off
// Возвращает фиксированные цвета интерфейса, не зависящие от стиля конфигурации.
//
// Возвращаемое значение:
//  Структура - цвета фона, панелей, границ и текста.
//
&НаКлиентеНаСервереБезКонтекста
Функция ЦветаИгры()

	Цвета = Новый Структура;
	Цвета.Вставить("Фон", Новый Цвет(224, 224, 224));
	Цвета.Вставить("Панель", Новый Цвет(196, 196, 196));
	Цвета.Вставить("Граница", Новый Цвет(112, 112, 112));
	Цвета.Вставить("Текст", Новый Цвет(48, 48, 48));
	Возврат Цвета;

КонецФункции

&НаКлиенте
Процедура ПодготовитьЭкран(ИгровоеПоле = Ложь)

	Элементы.ПолеИгры.Доступность = Истина;

	Если ИгровоеПоле Тогда

		Если ИзображенияИгры = Неопределено Тогда

			ГрафикаИгры = ПодготовитьГрафикуНаСервере();
			ИзображенияИгры = ГрафикаИгры.Изображения;
			ДокументИгровогоПоля = ГрафикаИгры.Поле;
			ГеометрияКлеток = ГрафикаИгры.Геометрия;

		КонецЕсли;

		ЭкранИгры = ДокументИгровогоПоля;
		ПоказанныеКлетки = Новый Массив(ЭкранИгры.Рисунки.Количество());

		Для Каждого Рисунок Из ЭкранИгры.Рисунки Цикл

			Рисунок.Картинка = ИзображенияИгры.Пустая;
			Рисунок.Ширина = 0;
			Рисунок.Высота = 0;

		КонецЦикла;

	Иначе

		ЭкранИгры = Новый ТабличныйДокумент;

	КонецЕсли;
	ЭкранИгры.ОтображатьСетку = Ложь;
	ЭкранИгры.ОтображатьЗаголовки = Ложь;
	Полотно = ОбластьЭкрана(1, 1, 120, 300);
	Полотно.ЦветФона = Палитра.Фон;
	Полотно.ЦветТекста = Палитра.Текст;
	Полотно.Шрифт = Новый Шрифт("Consolas", 11);
	Полотно.ШиринаКолонки = 3;
	Полотно.ВысотаСтроки = 15;
	Полотно.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	Полотно.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Элементы.ПолеИгры.РежимОтображенияВыделения = РежимОтображенияВыделения.НеОтображать;
	Элементы.ПолеИгры.Редактирование = Ложь;

КонецПроцедуры

&НаКлиенте
Функция ОбластьЭкрана(Верх, Левая, Низ, Правая)

	Возврат ЭкранИгры.Область(Верх, Левая, Низ, Правая);

КонецФункции

&НаКлиенте
Процедура Надпись(Верх, Низ, Текст, Крупно = Ложь)

	ОбластьТекста = ОбластьЭкрана(Верх, 3, Низ, 26);
	ОбластьТекста.Объединить();
	ОбластьТекста.Текст = Текст;

	Если Крупно Тогда

		ОбластьТекста.Шрифт = Новый Шрифт("Consolas", 22, Истина);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КнопкаНаЭкране(Верх, Подпись, Действие)

	ОбластьКнопки = ОбластьЭкрана(Верх, 6, Верх + 2, 23);
	ОбластьКнопки.Объединить();
	ОбластьКнопки.Текст = Подпись;
	ОбластьКнопки.ЦветФона = Палитра.Панель;
	ОбластьКнопки.ЦветТекста = Палитра.Текст;
	ОбластьКнопки.Шрифт = Новый Шрифт("Consolas", 13, Истина);
	ОбластьКнопки.Расшифровка = Действие;
	ОбластьКнопки.Гиперссылка = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМеню()

	ОстановитьОжидание();
	СостояниеЭкрана = "Меню";
	ПодготовитьЭкран();
	Надпись(4, 6, "1SnakeGame", Истина);
	Надпись(8, 9, НСтр("ru = 'ЗМЕЙКА НА КОЛЕСАХ'"));
	КнопкаНаЭкране(12, НСтр("ru = 'начать игру'"), "Начать");
	КнопкаНаЭкране(17, НСтр("ru = 'посмотреть статистику'"), "Статистика");
	Надпись(23, 24, НСтр("ru = 'Собирайте яблоки. Избегайте стен и прицепа.'"));
	Надпись(26, 27, НСтр("ru = 'Стрелки - движение | Пробел - пауза | Esc - в меню'"));

КонецПроцедуры

&НаКлиенте
Процедура НарисоватьПодсказкуИгры()

	Если СостояниеЭкрана = "Пауза" Тогда

		ТекстПодсказки = НСтр("ru = 'ПАУЗА | Пробел - продолжить | Esc - в меню'");

	Иначе

		ТекстПодсказки = НСтр("ru = 'Стрелки - движение | Пробел - пауза | Esc - в меню'");

	КонецЕсли;
	Надпись(29, 30, ТекстПодсказки);

КонецПроцедуры

&НаКлиенте
Процедура НарисоватьСчет()

	Надпись(3, 4, СтрШаблон(НСтр("ru = 'Счет: %1     Длина: %2'"), Игра.Очки, Игра.Змейка.Количество()));

КонецПроцедуры

&НаКлиенте
Функция НомерКлетки(Позиция)

	Возврат (Позиция.Ряд - 1) * Игра.Правила.Колонок + Позиция.Колонка - 1;

КонецФункции

&НаКлиенте
Процедура ОбновитьКлеткиШага(ПрежнийХвост)

	Изменения = Новый Соответствие;
	// Окончательное занятое состояние перекрывает освобождение, в том числе вход головы в прежний хвост.
	Изменения.Вставить(НомерКлетки(ПрежнийХвост), -1);
	Последний = Игра.Змейка.Количество() - 1;
	Изменения.Вставить(НомерКлетки(Игра.Змейка[Последний]), Последний);
	Для Индекс = 0 По Мин(Игра.Правила.НачальнаяДлина + 1, Последний) Цикл

		Изменения.Вставить(НомерКлетки(Игра.Змейка[Индекс]), Индекс);

	КонецЦикла;
	Для Каждого Изменение Из Изменения Цикл

		Позиция = Клетка(Изменение.Ключ % Игра.Правила.Колонок + 1,
			Цел(Изменение.Ключ / Игра.Правила.Колонок) + 1);
		НарисоватьКлетку(Позиция, Изменение.Значение);

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура НарисоватьКлетку(Позиция, ИндексЗвена = Неопределено)

	Номер = НомерКлетки(Позиция);
	Представление = ПредставлениеКлетки(Позиция, ИндексЗвена);
	Прежнее = ПоказанныеКлетки[Номер];
	Если Прежнее <> Неопределено И Прежнее.Ключ = Представление.Ключ Тогда

		Возврат;

	КонецЕсли;
	Рисунок = ЭкранИгры.Рисунки[Номер];
	Если Представление.Размещение = "Скрыто" Тогда

		Если Прежнее = Неопределено Тогда

			Возврат;

		КонецЕсли;
		Рисунок.Ширина = 0;
		Рисунок.Высота = 0;

	ИначеЕсли Представление.Размещение = "Автопоезд" Тогда

		РазместитьАвтопоезд(Рисунок);

	Иначе

		Если Прежнее = Неопределено Или Прежнее.Размещение <> "Клетка" Тогда

			РазместитьКартинку(Рисунок, Позиция);

		КонецЕсли;

	КонецЕсли;
	Рисунок.Картинка = Представление.Картинка;
	ПоказанныеКлетки[Номер] = Представление;

КонецПроцедуры

&НаКлиенте
Функция ПредставлениеКлетки(Позиция, Знач ИндексЗвена)

	Если СовпадаютКлетки(Позиция, Игра.Еда) Тогда

		Возврат ПредставлениеРисунка("Яблоко", ИзображенияИгры.Яблоко);

	КонецЕсли;
	Если ИндексЗвена = Неопределено Тогда

		ИндексЗвена = -1;
		Для Индекс = 0 По Игра.Змейка.Количество() - 1 Цикл

			Если СовпадаютКлетки(Позиция, Игра.Змейка[Индекс]) Тогда

				ИндексЗвена = Индекс;
				Прервать;

			КонецЕсли;

		КонецЦикла;

	КонецЕсли;
	Если ИндексЗвена < 0 Тогда

		Возврат ПредставлениеРисунка("", ИзображенияИгры.Пустая, "Скрыто");

	КонецЕсли;
	Если ИндексЗвена > 0 Тогда

		Возврат ПредставлениеСекции(ИндексЗвена);

	КонецЕсли;
	Если АвтопоездНаПрямой() Тогда

		Возврат ПредставлениеРисунка("Автопоезд/" + Игра.Направление,
			ИзображенияИгры.Автопоезд.Получить(Игра.Направление), "Автопоезд");

	КонецЕсли;
	Возврат ПредставлениеРисунка("Тягач/" + Игра.Направление, ИзображенияИгры.Тягач.Получить(Игра.Направление));

КонецФункции

&НаКлиенте
Функция ПредставлениеРисунка(Ключ, Картинка, Размещение = "Клетка")

	Возврат Новый Структура("Ключ,Картинка,Размещение", Ключ, Картинка, Размещение);

КонецФункции

&НаКлиенте
Функция ПредставлениеСекции(Индекс)

	Если Индекс < Игра.Правила.НачальнаяДлина И АвтопоездНаПрямой() Тогда

		Возврат ПредставлениеРисунка("", ИзображенияИгры.Пустая, "Скрыто");

	КонецЕсли;

	Позиция = Игра.Змейка[Индекс];
	Направление = НаправлениеМеждуКлетками(Позиция, Игра.Змейка[Индекс - 1]);

	Если Индекс < Игра.Змейка.Количество() - 1 Тогда

		НаправлениеНазад = НаправлениеМеждуКлетками(Позиция, Игра.Змейка[Индекс + 1]);
		КлючПоворота = СтрШаблон("%1/%2", Направление, НаправлениеНазад);
		Сочленение = ИзображенияИгры.Сочленения.Получить(КлючПоворота);

		Если Сочленение <> Неопределено Тогда

			Возврат ПредставлениеРисунка("Угол/" + КлючПоворота, Сочленение);

		КонецЕсли;

	КонецЕсли;

	Если Индекс < Игра.Правила.НачальнаяДлина Тогда

		Возврат ПредставлениеРисунка(СтрШаблон("Секция%1/%2", Индекс, Направление),
			ИзображенияИгры.ЧастиАвтопоезда[Индекс].Получить(Направление));

	ИначеЕсли Игра.Змейка.Количество() = Игра.Правила.НачальнаяДлина + 1 Тогда

		Возврат ПредставлениеРисунка("Прицеп/" + Направление,
			ИзображенияИгры.ПрицепЦеликом.Получить(Направление));

	ИначеЕсли Индекс = Игра.Змейка.Количество() - 1 Тогда

		Возврат ПредставлениеРисунка("Конец/" + Направление, ИзображенияИгры.КонецПрицепа.Получить(Направление));

	ИначеЕсли Индекс = Игра.Правила.НачальнаяДлина Тогда

		Возврат ПредставлениеРисунка("Начало/" + Направление, ИзображенияИгры.НачалоПрицепа.Получить(Направление));

	Иначе

		Возврат ПредставлениеРисунка("Середина/" + Направление,
			ИзображенияИгры.СерединаПрицепа.Получить(Направление));

	КонецЕсли;

КонецФункции

&НаКлиенте
Процедура РазместитьКартинку(Рисунок, Позиция)

	Номер = (Позиция.Ряд - 1) * Игра.Правила.Колонок + Позиция.Колонка - 1;
	Геометрия = ГеометрияКлеток[Номер];
	Рисунок.Лево = Геометрия.Лево;
	Рисунок.Верх = Геометрия.Верх;
	Рисунок.Ширина = Геометрия.Ширина;
	Рисунок.Высота = Геометрия.Высота;

КонецПроцедуры

&НаКлиенте
Функция АвтопоездНаПрямой()

	ПерваяСвязь = НаправлениеМеждуКлетками(Игра.Змейка[1], Игра.Змейка[0]);
	ВтораяСвязь = НаправлениеМеждуКлетками(Игра.Змейка[2], Игра.Змейка[1]);
	Возврат ПерваяСвязь = Игра.Направление И ВтораяСвязь = Игра.Направление;

КонецФункции

&НаКлиенте
Процедура РазместитьАвтопоезд(Рисунок)

	Голова = Игра.Змейка[0];
	ХвостАвтопоезда = Игра.Змейка[2];
	ЛеваяВерхняя = Клетка(Мин(Голова.Колонка, ХвостАвтопоезда.Колонка),
		Мин(Голова.Ряд, ХвостАвтопоезда.Ряд));
	РазместитьКартинку(Рисунок, ЛеваяВерхняя);

	Если Голова.Ряд = ХвостАвтопоезда.Ряд Тогда

		Рисунок.Ширина = Рисунок.Ширина * Игра.Правила.НачальнаяДлина;

	Иначе

		Рисунок.Высота = Рисунок.Высота * Игра.Правила.НачальнаяДлина;

	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НаправлениеМеждуКлетками(Откуда, Куда)

	Если Куда.Колонка > Откуда.Колонка Тогда

		Возврат "Вправо";

	ИначеЕсли Куда.Колонка < Откуда.Колонка Тогда

		Возврат "Влево";

	ИначеЕсли Куда.Ряд > Откуда.Ряд Тогда

		Возврат "Вниз";

	Иначе

		Возврат "Вверх";

	КонецЕсли;

КонецФункции

&НаСервере
Функция ПодготовитьГрафикуНаСервере()

	ОбработкаИгры = РеквизитФормыВЗначение("Объект");
	// Макеты уже обрезаны и уменьшены при подготовке поставки.
	Автопоезд = Новый Картинка(ОбработкаИгры.ПолучитьМакет("Тягач"));
	Прицеп = Новый Картинка(ОбработкаИгры.ПолучитьМакет("Полуприцеп"));
	Яблоко = Новый Картинка(ОбработкаИгры.ПолучитьМакет("Яблоко"));
	АтласСочленений = Новый Картинка(ОбработкаИгры.ПолучитьМакет("УгловыеСочленения"));
	Изображения = Новый Структура;
	Изображения.Вставить("Пустая", Новый Картинка);
	Изображения.Вставить("Яблоко", Яблоко);
	Изображения.Вставить("Автопоезд", ВариантыНаправлений(Автопоезд));
	ЧастиАвтопоезда = Новый Массив;
	РазмерСекции = РазмерСекцииИзображения();

	ЧастиАвтопоезда.Добавить(ВариантыНаправлений(ПоловинаПрицепа(Автопоезд, 2 * РазмерСекции)));
	ЧастиАвтопоезда.Добавить(ВариантыНаправлений(ПоловинаПрицепа(Автопоезд, РазмерСекции)));
	ЧастиАвтопоезда.Добавить(ВариантыНаправлений(ПоловинаПрицепа(Автопоезд, 0)));
	Изображения.Вставить("ЧастиАвтопоезда", ЧастиАвтопоезда);
	Изображения.Вставить("Тягач", ЧастиАвтопоезда[0]);
	Изображения.Вставить("ПрицепЦеликом", ВариантыНаправлений(Прицеп));
	Изображения.Вставить("НачалоПрицепа", ВариантыНаправлений(ПоловинаПрицепа(Прицеп, РазмерСекции)));
	Середина = Новый ОбрабатываемаяКартинка(Прицеп);
	Середина.ВыделитьОбласть(РазмерСекции, 0, 1, РазмерСекции);
	Середина.УстановитьРазмер(РазмерСекции, РазмерСекции);
	Изображения.Вставить("СерединаПрицепа", ВариантыНаправлений(Середина.ПолучитьКартинку()));
	Изображения.Вставить("КонецПрицепа", ВариантыНаправлений(ПоловинаПрицепа(Прицеп, 0)));
	Изображения.Вставить("Сочленения", КартинкиСочленений(АтласСочленений));
	Геометрия = Новый Массив;
	Поле = Новый ТабличныйДокумент;
	Поле.Область(1, 1, 120, 300).Шрифт = Новый Шрифт("Consolas", 11);
	Поле.Область(1, 1, 120, 300).ШиринаКолонки = 3;
	Поле.Область(1, 1, 120, 300).ВысотаСтроки = 15;
	Правила = ПравилаИгры();
	ПалитраПоля = ЦветаИгры();
	ЛинияБезРамки = Новый Линия(ТипЛинииРисункаТабличногоДокумента.НетЛинии, 0);

	// Добавление и размещение рисунков недоступны тонкому клиенту.
	// Пустой пул создается один раз; шаг меняет только картинки нескольких клеток.
	Для Ряд = 1 По Правила.Рядов Цикл

		Для Колонка = 1 По Правила.Колонок Цикл

			Рисунок = Поле.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Картинка);
			Рисунок.Картинка = Изображения.Пустая;
			Рисунок.РазмерКартинки = РазмерКартинки.Растянуть;
			Рисунок.Защита = Истина;
			Рисунок.ЦветФона = ПалитраПоля.Фон;
			Рисунок.ЦветЛинии = ПалитраПоля.Фон;
			// Контур цвета фона создает видимую щель даже между соприкасающимися картинками.
			Рисунок.Линия = ЛинияБезРамки;
			Рисунок.ГраницаСверху = Ложь;
			Рисунок.ГраницаСлева = Ложь;
			Рисунок.ГраницаСнизу = Ложь;
			Рисунок.ГраницаСправа = Ложь;
			Рисунок.Расположить(Поле.Область(Ряд + 6, Колонка + 2));
			Геометрия.Добавить(Новый Структура("Лево,Верх,Ширина,Высота",
				Рисунок.Лево, Рисунок.Верх, Рисунок.Ширина, Рисунок.Высота));
			Рисунок.Ширина = 0;
			Рисунок.Высота = 0;

		КонецЦикла;

	КонецЦикла;

	Возврат Новый Структура("Изображения,Поле,Геометрия", Изображения, Поле, Геометрия);

КонецФункции

&НаСервереБезКонтекста
Функция КартинкиСочленений(Атлас)

	ПоЧасовой = ВариантыНаправлений(ПоловинаПрицепа(Атлас, 0));
	ПротивЧасовой = ВариантыНаправлений(ПоловинаПрицепа(Атлас, РазмерСекцииИзображения()));
	Сочленения = Новый Соответствие;
	Сочленения.Вставить("Вправо/Вниз", ПоЧасовой.Получить("Вправо"));
	Сочленения.Вставить("Вверх/Вправо", ПоЧасовой.Получить("Вверх"));
	Сочленения.Вставить("Влево/Вверх", ПоЧасовой.Получить("Влево"));
	Сочленения.Вставить("Вниз/Влево", ПоЧасовой.Получить("Вниз"));
	Сочленения.Вставить("Вниз/Вправо", ПротивЧасовой.Получить("Вправо"));
	Сочленения.Вставить("Вправо/Вверх", ПротивЧасовой.Получить("Вверх"));
	Сочленения.Вставить("Вверх/Влево", ПротивЧасовой.Получить("Влево"));
	Сочленения.Вставить("Влево/Вниз", ПротивЧасовой.Получить("Вниз"));
	Возврат Сочленения;

КонецФункции

&НаСервереБезКонтекста
Функция РазмерСекцииИзображения()

	Возврат 64;

КонецФункции

&НаСервереБезКонтекста
Функция ПоловинаПрицепа(Полуприцеп, Левая)

	РазмерСекции = РазмерСекцииИзображения();
	Фрагмент = Новый ОбрабатываемаяКартинка(Полуприцеп);
	Фрагмент.ВыделитьОбласть(Левая, 0, РазмерСекции, РазмерСекции);
	Возврат Фрагмент.ПолучитьКартинку();

КонецФункции

&НаСервереБезКонтекста
Функция ВариантыНаправлений(Исходная)

	Варианты = Новый Соответствие;
	Варианты.Вставить("Вправо", Исходная);
	Углы = Новый Структура("Вверх,Вниз,Влево", 90, 270, 180);

	Для Каждого Поворот Из Углы Цикл

		Повернутая = Новый ОбрабатываемаяКартинка(Исходная);
		Повернутая.Повернуть(Поворот.Значение);
		Варианты.Вставить(Поворот.Ключ, Повернутая.ПолучитьКартинку());

	КонецЦикла;

	Возврат Варианты;

КонецФункции

&НаКлиенте
Процедура ПоказатьРезультат()

	ОстановитьОжидание();
	ПодготовитьЭкран();
	Надпись(4, 6, Игра.Исход, Истина);
	Надпись(8, 10, СтрШаблон(НСтр("ru = 'Ваш счет: %1'"), Игра.Очки), Истина);

	Если РезультатСохранен Тогда

		Если РезультатВТопе Тогда

			Надпись(13, 14, НСтр("ru = 'Результат сохранен в общей таблице рекордов.'"));

		Иначе

			Надпись(13, 14, НСтр("ru = 'Партия завершена. Результат не вошел в топ-10.'"));

		КонецЕсли;
		КнопкаНаЭкране(18, НСтр("ru = 'в главное меню'"), "Меню");

	Иначе

		Надпись(12, 13, НСтр("ru = 'Результат не сохранен'"));
		Надпись(14, 16, ОшибкаСохранения);
		КнопкаНаЭкране(18, НСтр("ru = 'повторить сохранение'"), "ПовторитьСохранение");
		КнопкаНаЭкране(22, НСтр("ru = 'в меню без сохранения'"), "Меню");
		Надпись(27, 29, НСтр("ru = 'При выходе или закрытии результат будет потерян.'"));

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьРезультат()

	// Перехватывается отказ серверного вызова: итог игры остается доступен для явного повтора.
	Попытка

		ИтогСохранения = СохранитьПартиюНаСервере(Игра.ИдентификаторПартии,
			Игра.Очки, Игра.Змейка.Количество(), Игра.Исход);
		РезультатСохранен = Истина;
		РезультатВТопе = ИтогСохранения.ВТопе;
		ОшибкаСохранения = "";

	Исключение

		РезультатСохранен = Ложь;
		ОшибкаСохранения = ОписаниеОшибки();

	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтатистику()

	ОстановитьОжидание();
	СостояниеЭкрана = "Статистика";
	ПодготовитьЭкран();
	Надпись(2, 4, НСтр("ru = 'Таблица рекордов'"), Истина);
	Надпись(5, 6, НСтр("ru = '10 лучших партий всех игроков этой базы'"));
	КнопкаНаЭкране(25, НСтр("ru = 'в главное меню'"), "Меню");

	Попытка

		Рекорды = ПрочитатьРекордыНаСервере();

	Исключение

		Надпись(10, 11, НСтр("ru = 'Не удалось прочитать таблицу рекордов.'"));
		Надпись(13, 19, ОписаниеОшибки());
		Возврат;

	КонецПопытки;

	СтрокаСтатистики(8, 3, 4, НСтр("ru = 'Место'"), Палитра.Панель);
	СтрокаСтатистики(8, 5, 13, НСтр("ru = 'Игрок'"), Палитра.Панель);
	СтрокаСтатистики(8, 14, 17, НСтр("ru = 'Очки'"), Палитра.Панель);
	СтрокаСтатистики(8, 18, 26, НСтр("ru = 'Дата и время'"), Палитра.Панель);

	Если Рекорды.Количество() = 0 Тогда

		Надпись(12, 14, НСтр("ru = 'Рекордов пока нет'"));
		Возврат;

	КонецЕсли;

	Место = 0;

	Для Каждого Рекорд Из Рекорды Цикл

		Место = Место + 1;
		Ряд = 9 + Место;
		Фон = Палитра.Фон;

		Если Место % 2 = 0 Тогда

			Фон = Палитра.Панель;

		КонецЕсли;

		СтрокаСтатистики(Ряд, 3, 4, Строка(Место), Фон);
		СтрокаСтатистики(Ряд, 5, 13, Рекорд.ИмяИгрока, Фон);
		СтрокаСтатистики(Ряд, 14, 17, Строка(Рекорд.Очки), Фон);
		СтрокаСтатистики(Ряд, 18, 26, Формат(Рекорд.МоментЗавершения, "ДФ=dd.MM.yyyy HH:mm"), Фон);

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СтрокаСтатистики(Ряд, Левая, Правая, Текст, Фон)

	ОбластьЗначения = ОбластьЭкрана(Ряд, Левая, Ряд, Правая);
	ОбластьЗначения.Объединить();
	ОбластьЗначения.Текст = Текст;
	ОбластьЗначения.ЦветФона = Фон;
	ОбластьЗначения.Шрифт = Новый Шрифт("Consolas", 9);

КонецПроцедуры

// BSLLS:StyleElementConstructors-on

&НаСервереБезКонтекста
Функция СохранитьПартиюНаСервере(Знач ИдентификаторПартии, Знач Очки, Знач ДлинаЗмейки, Знач Исход)

	ПроверитьИтогПартии(Очки, ДлинаЗмейки, Исход);
	Идентификатор = Строка(Новый УникальныйИдентификатор(ИдентификаторПартии));
	КлючРезультата = СтрШаблон("1SnakeGame/Results/v1/%1", Идентификатор);
	ПрежняяЗапись = ХранилищеСистемныхНастроек.ЗагрузитьНастройкуПоУмолчанию(КлючРезультата);

	Если ПрежняяЗапись <> Неопределено Тогда

		ПроверитьЗаписьРезультата(ПрежняяЗапись);
		ЗаписьРезультата = ПрежняяЗапись;

	Иначе

		ИмяИгрока = СокрЛП(ИмяПользователя());

		Если ИмяИгрока = "" Тогда

			ИмяИгрока = НСтр("ru = 'Игрок'");

		КонецЕсли;

		ЗаписьРезультата = Новый Структура;
		ЗаписьРезультата.Вставить("ВерсияФормата", 1);
		ЗаписьРезультата.Вставить("ИдентификаторПартии", Идентификатор);
		ЗаписьРезультата.Вставить("ИмяИгрока", ИмяИгрока);
		ЗаписьРезультата.Вставить("Очки", Очки);
		ЗаписьРезультата.Вставить("ДлинаЗмейки", ДлинаЗмейки);
		ЗаписьРезультата.Вставить("Исход", Исход);
		ЗаписьРезультата.Вставить("МоментЗавершения", ТекущаяДатаСеанса());
		ХранилищеСистемныхНастроек.СохранитьНастройкуПоУмолчанию(КлючРезультата, ЗаписьРезультата);

	КонецЕсли;

	Лучшие = ПрочитатьРекордыНаСервере();
	ЗаписьРезультата.Вставить("ВТопе", Ложь);

	Для Каждого Рекорд Из Лучшие Цикл

		Если Рекорд.ИдентификаторПартии = Идентификатор Тогда

			ЗаписьРезультата.ВТопе = Истина;
			Прервать;

		КонецЕсли;

	КонецЦикла;

	Возврат ЗаписьРезультата;

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьИтогПартии(Очки, ДлинаЗмейки, Исход)

	Правила = ПравилаИгры();

	Если ТипЗнч(Очки) <> Тип("Число") Или ТипЗнч(ДлинаЗмейки) <> Тип("Число") Тогда

		ВызватьИсключение НСтр("ru = 'Некорректный результат партии.'");

	КонецЕсли;

	Если ДлинаЗмейки <> Цел(ДлинаЗмейки) Или ДлинаЗмейки < Правила.НачальнаяДлина
		Или ДлинаЗмейки > Правила.Колонок * Правила.Рядов
		Или Очки <> (ДлинаЗмейки - Правила.НачальнаяДлина) * Правила.ОчковЗаЕду Тогда

		ВызватьИсключение НСтр("ru = 'Счет не соответствует длине змейки.'");

	КонецЕсли;

	Если Исход <> "Победа" И Исход <> "Поражение" Тогда

		ВызватьИсключение НСтр("ru = 'Партия не завершена.'");

	КонецЕсли;

	Если (Исход = "Победа") <> (ДлинаЗмейки = Правила.Колонок * Правила.Рядов) Тогда

		ВызватьИсключение НСтр("ru = 'Некорректный исход партии.'");

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьЗаписьРезультата(ЗаписьРезультата)

	Если ТипЗнч(ЗаписьРезультата) <> Тип("Структура") Тогда

		ВызватьИсключение НСтр("ru = 'Неподдерживаемый формат рекордов.'");

	КонецЕсли;

	Поля = СтрРазделить("ВерсияФормата,ИдентификаторПартии,ИмяИгрока,Очки,ДлинаЗмейки,Исход,МоментЗавершения", ",");

	Для Каждого ИмяПоля Из Поля Цикл

		Если Не ЗаписьРезультата.Свойство(ИмяПоля) Тогда

			ВызватьИсключение НСтр("ru = 'Неподдерживаемый формат рекордов.'");

		КонецЕсли;

	КонецЦикла;

	Если ЗаписьРезультата.ВерсияФормата <> 1
		Или ТипЗнч(ЗаписьРезультата.ИдентификаторПартии) <> Тип("Строка")
		Или ТипЗнч(ЗаписьРезультата.ИмяИгрока) <> Тип("Строка")
		Или ТипЗнч(ЗаписьРезультата.МоментЗавершения) <> Тип("Дата") Тогда

		ВызватьИсключение НСтр("ru = 'Неподдерживаемый формат рекордов.'");

	КонецЕсли;

	ПроверитьИтогПартии(ЗаписьРезультата.Очки, ЗаписьРезультата.ДлинаЗмейки, ЗаписьРезультата.Исход);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьРекордыНаСервере()

	Результаты = Новый ТаблицаЗначений;
	Результаты.Колонки.Добавить("ИмяИгрока");
	Результаты.Колонки.Добавить("Очки");
	Результаты.Колонки.Добавить("МоментЗавершения");
	Результаты.Колонки.Добавить("ИдентификаторПартии");
	Результаты.Колонки.Добавить("КлючРезультата");
	Префикс = "1SnakeGame/Results/v1/";
	Выборка = ХранилищеСистемныхНастроек.ВыбратьНастройкиПоУмолчанию();

	Пока Выборка.Следующий() Цикл

		КлючРезультата = Выборка.КлючОбъекта;

		Если Лев(КлючРезультата, СтрДлина(Префикс)) <> Префикс Тогда

			Продолжить;

		КонецЕсли;

		ЗаписьРезультата = ХранилищеСистемныхНастроек.ЗагрузитьНастройкуПоУмолчанию(КлючРезультата);

		Если ЗаписьРезультата = Неопределено Тогда

			Продолжить;

		КонецЕсли;

		ПроверитьЗаписьРезультата(ЗаписьРезультата);
		СтрокаРезультата = Результаты.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРезультата, ЗаписьРезультата);
		СтрокаРезультата.КлючРезультата = КлючРезультата;

	КонецЦикла;

	Результаты.Сортировать("Очки Убыв, МоментЗавершения Возр, ИдентификаторПартии Возр");
	РазмерТаблицыРекордов = 10;
	// Удаление только проигравших ключей не перезаписывает результат другого сеанса.
	// Стабильный полный порядок сохраняет лучшие партии при пересекающихся очистках.
	Для Индекс = РазмерТаблицыРекордов По Результаты.Количество() - 1 Цикл

		ХранилищеСистемныхНастроек.УдалитьНастройкуПоУмолчанию(Результаты[Индекс].КлючРезультата);

	КонецЦикла;

	Лучшие = Новый Массив;

	Для Индекс = 0 По Мин(Результаты.Количество(), РазмерТаблицыРекордов) - 1 Цикл

		ЛучшаяПартия = Новый Структура("ИмяИгрока,Очки,МоментЗавершения,ИдентификаторПартии");
		ЗаполнитьЗначенияСвойств(ЛучшаяПартия, Результаты[Индекс]);
		Лучшие.Добавить(ЛучшаяПартия);

	КонецЦикла;

	Возврат Лучшие;

КонецФункции

#КонецОбласти
